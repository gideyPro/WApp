<?xml version="1.0" encoding="utf-8"?>
<!--
  Base config blocks cleartext (http) traffic everywhere.
  The "localhost" placeholder below is only ever active in builds where
  no one replaced it (Play/release): cleartext to localhost is unreachable
  from a production app, so prod behavior is unchanged.

  The "Build Local APK" GitHub workflow (build-local.yml) replaces
  "localhost" with the LAN host from the api_base_url input at build time,
  allowing that one release-signed APK to talk to a local backend over http.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
